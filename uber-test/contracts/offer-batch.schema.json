{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test.invalid/uber-test/offer-batch.schema.json",
  "type": "object",
  "required": ["id", "environment", "offers"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "environment": { "const": "TEST" },
    "createdAt": { "type": "string", "format": "date-time" },
    "offers": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "service", "fare", "currency", "pickup", "pickupDistanceKm", "tripDurationMinutes", "tripDistanceKm", "expiresAfterSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "fare": { "type": "number", "minimum": 0 },
          "currency": { "const": "MXN" },
          "pickup": { "type": "string", "minLength": 1 },
          "pickupDistanceKm": { "type": "number", "minimum": 0 },
          "tripDurationMinutes": { "type": "number", "minimum": 0 },
          "tripDistanceKm": { "type": "number", "minimum": 0 },
          "riderRating": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
          "expiresAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 120 }
        }
      }
    }
  }
}
